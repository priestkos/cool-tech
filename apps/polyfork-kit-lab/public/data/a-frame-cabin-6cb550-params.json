{
  "params": {
    "colorway": {
      "type": "choice",
      "default": "forest-green",
      "label": "Colorway",
      "options": ["forest-green", "moss-olive", "slate-and-blue", "cedar-shake"]
    },
    "season": {
      "type": "choice",
      "default": "summer",
      "label": "Season",
      "options": ["spring", "summer", "autumn", "winter"]
    },
    "wear": {
      "type": "range",
      "default": 0.3,
      "label": "Wear",
      "min": 0,
      "max": 1,
      "step": 0.1
    },
    "stovepipe": {
      "type": "toggle",
      "default": true,
      "label": "Stovepipe"
    },
    "roof": {
      "type": "color",
      "default": "#223221",
      "label": "Roof"
    }
  }
}