//#region src/core/graph/value.d.ts
type EagerDtype = 'f32' | 'f16' | 'quantW';
/** Everything known about a Value without computing it. quantW is the
 *  exception: `dims` stay logical while `elems` is a u32 word count. */
interface ValueMeta {
